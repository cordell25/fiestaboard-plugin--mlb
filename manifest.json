{
  "id": "mlbeta",
  "name": "Major League Baseball (MLB) - BETA",
  "version": "1.6.1",
  "description": "Track MLB Game Scores",
  "author": "Andrew Cordell",
  "icon": "trophy",
  "category": "data",
  "repository": "https://github.com/cordell25/fiestaboard-plugin--mlb",
  "documentation": "README.md",
  "min_refresh_seconds": 60,
  "settings_schema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "title": "Enabled",
        "default": false
      },
      "teams": {
        "type": "array",
        "title": "Team to track",
        "description": "Select MLB team to display games score",
        "items": {
          "type": "string",
          "enum": [
            "Arizona Diamondbacks",
            "Athletics",
            "Atlanta Braves",
            "Baltimore Orioles",
            "Boston Red Sox",
            "Chicago Cubs",
            "Chicago White Sox",
            "Cincinnati Reds",
            "Cleveland Guardians",
            "Colorado Rockies",
            "Detroit Tigers",
            "Houston Astros",
            "Kansas City Royals",
            "Los Angeles Angels",
            "Los Angeles Dodgers",
            "Miami Marlins",
            "Milwaukee Brewers",
            "Minnesota Twins",
            "New York Mets",
            "New York Yankees",
            "Philadelphia Phillies",
            "Pittsburgh Pirates",
            "San Diego Padres",
            "San Francisco Giants",
            "Seattle Mariners",
            "St. Louis Cardinals",
            "Tampa Bay Rays",
            "Texas Rangers",
            "Toronto Blue Jays",
            "Washington Nationals"
          ]
        },
        "uniqueItems": true
      },
      "timezone": {
        "type": "string",
        "title": "Timezone",
        "description": "IANA timezone for interpreting all-day events and formatting display times.",
        "default": "America/Los_Angeles",
        "ui:widget": "timezone"
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh Interval (seconds)",
        "description": "How often to refresh game data during a game. Starts 15 minutes prior to first pitch and continues until game concludes",
        "default": 180,
        "minimum": 60
      }
    },
    "required": ["teams"]
  },
  "variables": {
    "groups": {
      "game": { "label": "Game" },
      "teams": { "label": "Teams" },
      "stats": { "label": "Stats" }
    },
    "simple": {
      "games": {
        "description": "List of MLB games for configured teams",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "game_scheduled_start": {
              "description": "Localized game start time formatted to the configured timezone",
              "type": "string",
              "max_length": 20,
              "group": "game",
              "example": "7:10 PM"
            },
            "minutes_until_game": {
              "description": "Integer minutes remaining until the scheduled first pitch",
              "type": "integer",
              "max_length": 4,
              "group": "game",
              "example": "45"
            },
            "game_status_code": {
              "description": "Raw official status code tracking play state (`F` = Final, `P` = Pre-Game, `I` = In-Progress, `0` = No Game)",
              "type": "string",
              "max_length": 1,
              "group": "game",
              "example": "I"
            },
            "stadium": {
              "description": "Venue name where the scheduled game is taking place",
              "type": "string",
              "max_length": 15,
              "group": "game",
              "example": "Wrigley Field"
            },
            "current_inning": {
              "description": "The current frame integer value of an active live match",
              "type": "integer",
              "max_length": 2,
              "group": "stats",
              "example": "4"
            },
            "current_inning_state": {
              "description": "Current half-inning positioning description",
              "type": "string",
              "max_length": 6,
              "group": "stats",
              "example": "BOTTOM"
            },
            "home_team_name": {
              "description": "Full name of the home franchise",
              "type": "string",
              "max_length": 20,
              "group": "teams",
              "example": "Colorado Rockies"
            },
            "home_team_abbr": {
              "description": "Official 3-letter abbreviation code for the home team",
              "type": "string",
              "max_length": 3,
              "group": "teams",
              "example": "COL"
            },
            "home_team_club_name": {
              "description": "Common club/nickname identifier for the home team",
              "type": "string",
              "max_length": 20,
              "group": "teams",
              "example": "Rockies"
            },
            "home_team_color": {
              "description": "Vestaboard-compatible color block value assigned to the home franchise",
              "type": "string",
              "max_length": 6,
              "group": "teams",
              "example": "purple"
            },
            "away_team_name": {
              "description": "Full name of the visiting franchise",
              "type": "string",
              "max_length": 20,
              "group": "teams",
              "example": "Chicago Cubs"
            },
            "away_team_abbr": {
              "description": "Official 3-letter abbreviation code for the visiting team",
              "type": "string",
              "max_length": 3,
              "group": "teams",
              "example": "CHC"
            },
            "away_team_club_name": {
              "description": "Common club/nickname identifier for the visiting team",
              "type": "string",
              "max_length": 20,
              "group": "teams",
              "example": "Cubs"
            },
            "away_team_color": {
              "description": "Vestaboard-compatible color block value assigned to the visiting franchise",
              "type": "string",
              "max_length": 6,
              "group": "teams",
              "example": "blue"
            },
            "current_home_score": {
              "description": "Total runs accumulated by the home team",
              "type": "integer",
              "max_length": 2,
              "group": "stats",
              "example": "5"
            },
            "current_home_hits": {
              "description": "Total hits recorded by the home team",
              "type": "integer",
              "max_length": 2,
              "group": "stats",
              "example": "9"
            },
            "current_home_errors": {
              "description": "Total errors committed by the home team",
              "type": "integer",
              "max_length": 2,
              "group": "stats",
              "example": "1"
            },
            "current_away_score": {
              "description": "Total runs accumulated by the away team",
              "type": "integer",
              "max_length": 2,
              "group": "stats",
              "example": "3"
            },
            "current_away_hits": {
              "description": "Total hits recorded by the away team",
              "type": "integer",
              "max_length": 2,
              "group": "stats",
              "example": "6"
            },
            "current_away_errors": {
              "description": "Total errors committed by the away team",
              "type": "integer",
              "max_length": 2,
              "group": "stats",
              "example": "0"
            }
          }
        }
      }
    }
  },
  "teaser": "{67}CUBS  6",
  "previews": [
    {
      "device_type": "flagship",
      "rows": [
        "3RD      R H E",
        "{67}CUBS    3 6 0",
        "{68}ROCKIES 0 0 0",
        "",
        "",
        ""
      ]
    },
    {
      "device_type": "note",
      "rows": [
        "3RD      R H E",
        "{67}CUBS    3 6 0",
        "{68}ROCKIES 0 0 0"
      ]
    }
  ],
  "demo": {
    "flagship": {
      "name": "MLB - Upcoming Game - Demo - Flagship",
      "template": [
        "",
        "{{= PAD(SWITCH(mlb.game_status_code,\"P\",\"UPCOMING\",\"F\",\"FINAL\",\"I\",CONCAT(\" \",mlb.current_inning,SWITCH(mlb.current_inning,1,\"ST\",2,\"ND\",3,\"RD\",\"TH\")),\"UNKNOWN\"),8) }}R  H  E ",
        "{{= IF(OR(mlb.game_status_code!=\"I\",AND(mlb.game_status_code==\"I\",mlb.current_inning_state==\"Top\")),COLOR(mlb.away_team_color),\" \") }}{{= PAD(mlb.away_team_abbr,6) }}{{= PADLEFT(mlb.current_away_score,2) }}{{= PADLEFT(mlb.current_away_hits,3) }}{{= PADLEFT(mlb.current_away_errors,3) }}",
        "{{= IF(OR(mlb.game_status_code!=\"I\",AND(mlb.game_status_code=\"I\",mlb.current_inning_state=\"Bottom\")),COLOR(mlb.home_team_color),\" \") }}{{= PAD(mlb.home_team_abbr,6) }}{{= PADLEFT(mlb.current_home_score,2) }}{{= PADLEFT(mlb.current_home_hits,3) }}{{= PADLEFT(mlb.current_home_errors,3) }}",
        "",
        ""
      ],
      "line_metadata": [
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        }
      ]
    },
    "note": {
      "name": "MLB - Scoreboard - Demo - Note",
        "template": [ 
          "{{= PAD(SWITCH(mlb.game_status_code,\"P\",\"UPCOMING\",\"F\",\"FINAL\",\"I\",CONCAT(\" \",mlb.current_inning,SWITCH(mlb.current_inning,1,\"ST\",2,\"ND\",3,\"RD\",\"TH\")),\"UNKNOWN\"),8) }}R  H  E ",
          "{{= IF(OR(mlb.game_status_code!=\"I\",AND(mlb.game_status_code==\"I\",mlb.current_inning_state==\"Top\")),COLOR(mlb.away_team_color),\" \") }}{{= PAD(mlb.away_team_abbr,6) }}{{= PADLEFT(mlb.current_away_score,2) }}{{= PADLEFT(mlb.current_away_hits,3) }}{{= PADLEFT(mlb.current_away_errors,3) }}",
          "{{= IF(OR(mlb.game_status_code!=\"I\",AND(mlb.game_status_code=\"I\",mlb.current_inning_state=\"Bottom\")),COLOR(mlb.home_team_color),\" \") }}{{= PAD(mlb.home_team_abbr,6) }}{{= PADLEFT(mlb.current_home_score,2) }}{{= PADLEFT(mlb.current_home_hits,3) }}{{= PADLEFT(mlb.current_home_errors,3) }}"
      ],
      "line_metadata": [
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        }
      ]
    }
  }
}
