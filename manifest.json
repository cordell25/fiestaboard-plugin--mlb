{
  "id": "mlb",
  "name": "Major League Baseball (MLB) - BETA",
  "version": "1.6.5",
  "description": "Track MLB Game Scores",
  "author": "Andrew Cordell",
  "icon": "trophy",
  "category": "data",
  "repository": "https://github.com/cordell25/fiestaboard-plugin--mlb",
  "documentation": "README.md",
  "min_refresh_seconds": 60,
  "settings_schema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "title": "Enabled",
        "default": false
      },
      "teams": {
        "type": "array",
        "title": "Team to track",
        "description": "Select MLB team to display games score",
        "items": {
          "type": "string",
          "enum": [
            "Arizona Diamondbacks",
            "Athletics",
            "Atlanta Braves",
            "Baltimore Orioles",
            "Boston Red Sox",
            "Chicago Cubs",
            "Chicago White Sox",
            "Cincinnati Reds",
            "Cleveland Guardians",
            "Colorado Rockies",
            "Detroit Tigers",
            "Houston Astros",
            "Kansas City Royals",
            "Los Angeles Angels",
            "Los Angeles Dodgers",
            "Miami Marlins",
            "Milwaukee Brewers",
            "Minnesota Twins",
            "New York Mets",
            "New York Yankees",
            "Philadelphia Phillies",
            "Pittsburgh Pirates",
            "San Diego Padres",
            "San Francisco Giants",
            "Seattle Mariners",
            "St. Louis Cardinals",
            "Tampa Bay Rays",
            "Texas Rangers",
            "Toronto Blue Jays",
            "Washington Nationals"
          ]
        },
        "uniqueItems": true
      },
      "timezone": {
        "type": "string",
        "title": "Timezone",
        "description": "IANA timezone for interpreting all-day events and formatting display times.",
        "default": "America/Los_Angeles",
        "ui:widget": "timezone"
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh Interval (seconds)",
        "description": "How often to refresh game data during a game. Starts 15 minutes prior to first pitch and continues until game concludes",
        "default": 180,
        "minimum": 60
      }
    },
    "required": ["teams"]
  },
  "variables": {
    "groups": {
      "game": { "label": "Game" },
      "teams": { "label": "Teams" },
      "stats": { "label": "Stats" }
    },
    "arrays": {
      "games": {
        "label_field": "formatted",
        "item_fields": {
          "game_scheduled_start": {
            "description": "Scheduled start time (e.g., 7:05 PM)",
            "type": "string",
            "max_length": 20,
            "group": "game"
          },
          "minutes_until_game": {
            "description": "Minutes remaining until scheduled first pitch",
            "type": "number",
            "max_length": 4,
            "group": "game"
          },
          "game_status_code": {
            "description": "Single-letter status code (P: Preview/Upcoming, I: In-Progress, F: Final)",
            "type": "string",
            "max_length": 1,
            "group": "game"
          },
          "stadium": {
            "description": "Venue / ballpark name",
            "type": "string",
            "max_length": 15,
            "group": "game"
          },
          "current_inning": {
            "description": "Current inning number",
            "type": "number",
            "max_length": 2,
            "group": "game"
          },
          "current_inning_state": {
            "description": "Inning half / state (Top, Middle, Bottom, End)",
            "type": "string",
            "max_length": 6,
            "group": "game"
          },
          "home_team_name": {
            "description": "Full home team name (e.g., Colorado Rockies)",
            "type": "string",
            "max_length": 20,
            "group": "teams"
          },
          "home_team_abbr": {
            "description": "Home team three-letter abbreviation (e.g., COL)",
            "type": "string",
            "max_length": 3,
            "group": "teams"
          },
          "home_team_club_name": {
            "description": "Home team mascot/club name (e.g., Rockies)",
            "type": "string",
            "max_length": 20,
            "group": "teams"
          },
          "home_team_color": {
            "description": "Home team primary hex color code without #",
            "type": "string",
            "max_length": 6,
            "group": "teams"
          },
          "away_team_name": {
            "description": "Full away team name (e.g., Chicago Cubs)",
            "type": "string",
            "max_length": 20,
            "group": "teams"
          },
          "away_team_abbr": {
            "description": "Away team three-letter abbreviation (e.g., CHC)",
            "type": "string",
            "max_length": 3,
            "group": "teams"
          },
          "away_team_club_name": {
            "description": "Away team mascot/club name (e.g., Cubs)",
            "type": "string",
            "max_length": 20,
            "group": "teams"
          },
          "away_team_color": {
            "description": "Away team primary hex color code without #",
            "type": "string",
            "max_length": 6,
            "group": "teams"
          },
          "current_home_score": {
            "description": "Current runs scored by the home team",
            "type": "number",
            "max_length": 2,
            "group": "stats"
          },
          "current_home_hits": {
            "description": "Current hits recorded by the home team",
            "type": "number",
            "max_length": 2,
            "group": "stats"
          },
          "current_home_errors": {
            "description": "Current errors committed by the home team",
            "type": "number",
            "max_length": 2,
            "group": "stats"
          },
          "current_away_score": {
            "description": "Current runs scored by the away team",
            "type": "number",
            "max_length": 2,
            "group": "stats"
          },
          "current_away_hits": {
            "description": "Current hits recorded by the away team",
            "type": "number",
            "max_length": 2,
            "group": "stats"
          },
          "current_away_errors": {
            "description": "Current errors committed by the away team",
            "type": "number",
            "max_length": 2,
            "group": "stats"
          }
        }
      }
    }
  },
  "teaser": "{67}CUBS  6",
  "previews": [
    {
      "device_type": "flagship",
      "rows": [
        "3RD      R H E",
        "{67}CUBS    3 6 0",
        "{68}ROCKIES 0 0 0",
        "",
        "",
        ""
      ]
    },
    {
      "device_type": "note",
      "rows": [
        "3RD      R H E",
        "{67}CUBS    3 6 0",
        "{68}ROCKIES 0 0 0"
      ]
    }
  ],
  "demo": {
    "flagship": {
      "name": "MLB - Upcoming Game - Demo - Flagship",
      "template": [
        "",
        "{{= PAD(SWITCH(mlb.game_status_code,\"P\",\"UPCOMING\",\"F\",\"FINAL\",\"I\",CONCAT(\" \",mlb.current_inning,SWITCH(mlb.current_inning,1,\"ST\",2,\"ND\",3,\"RD\",\"TH\")),\"UNKNOWN\"),8) }}R  H  E ",
        "{{= IF(OR(mlb.game_status_code!=\"I\",AND(mlb.game_status_code==\"I\",mlb.current_inning_state==\"Top\")),COLOR(mlb.away_team_color),\" \") }}{{= PAD(mlb.away_team_abbr,6) }}{{= PADLEFT(mlb.current_away_score,2) }}{{= PADLEFT(mlb.current_away_hits,3) }}{{= PADLEFT(mlb.current_away_errors,3) }}",
        "{{= IF(OR(mlb.game_status_code!=\"I\",AND(mlb.game_status_code=\"I\",mlb.current_inning_state=\"Bottom\")),COLOR(mlb.home_team_color),\" \") }}{{= PAD(mlb.home_team_abbr,6) }}{{= PADLEFT(mlb.current_home_score,2) }}{{= PADLEFT(mlb.current_home_hits,3) }}{{= PADLEFT(mlb.current_home_errors,3) }}",
        "",
        ""
      ],
      "line_metadata": [
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        }
      ]
    },
    "note": {
      "name": "MLB - Scoreboard - Demo - Note",
        "template": [ 
          "{{= PAD(SWITCH(mlb.game_status_code,\"P\",\"UPCOMING\",\"F\",\"FINAL\",\"I\",CONCAT(\" \",mlb.current_inning,SWITCH(mlb.current_inning,1,\"ST\",2,\"ND\",3,\"RD\",\"TH\")),\"UNKNOWN\"),8) }}R  H  E ",
          "{{= IF(OR(mlb.game_status_code!=\"I\",AND(mlb.game_status_code==\"I\",mlb.current_inning_state==\"Top\")),COLOR(mlb.away_team_color),\" \") }}{{= PAD(mlb.away_team_abbr,6) }}{{= PADLEFT(mlb.current_away_score,2) }}{{= PADLEFT(mlb.current_away_hits,3) }}{{= PADLEFT(mlb.current_away_errors,3) }}",
          "{{= IF(OR(mlb.game_status_code!=\"I\",AND(mlb.game_status_code=\"I\",mlb.current_inning_state=\"Bottom\")),COLOR(mlb.home_team_color),\" \") }}{{= PAD(mlb.home_team_abbr,6) }}{{= PADLEFT(mlb.current_home_score,2) }}{{= PADLEFT(mlb.current_home_hits,3) }}{{= PADLEFT(mlb.current_home_errors,3) }}"
      ],
      "line_metadata": [
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        }
      ]
    }
  }
}
