{
  "id": "mlb",
  "name": "MLB",
  "version": "1.4.2",
  "description": "Track MLB Game Scores",
  "author": "Andrew Cordell",
  "icon": "trophy",
  "category": "data",
  "repository": "https://github.com/cordell25/fiestaboard-plugin--mlb",
  "documentation": "README.md",
  "min_refresh_seconds": 60,
  "settings_schema": {
    "type": "object",
    "properties": {
      "enabled": {
        "type": "boolean",
        "title": "Enabled",
        "default": false
      },
      "teams": {
        "type": "array",
        "title": "Team to track",
        "description": "Select MLB team to display games score",
        "minItems": 1,
        "maxItems": 1,
        "items": {
          "type": "string",
          "enum": [
            "Arizona Diamondbacks",
            "Athletics",
            "Atlanta Braves",
            "Baltimore Orioles",
            "Boston Red Sox",
            "Chicago Cubs",
            "Chicago White Sox",
            "Cincinnati Reds",
            "Cleveland Guardians",
            "Colorado Rockies",
            "Detroit Tigers",
            "Houston Astros",
            "Kansas City Royals",
            "Los Angeles Angels",
            "Los Angeles Dodgers",
            "Miami Marlins",
            "Milwaukee Brewers",
            "Minnesota Twins",
            "New York Mets",
            "New York Yankees",
            "Philadelphia Phillies",
            "Pittsburgh Pirates",
            "San Diego Padres",
            "San Francisco Giants",
            "Seattle Mariners",
            "St. Louis Cardinals",
            "Tampa Bay Rays",
            "Texas Rangers",
            "Toronto Blue Jays",
            "Washington Nationals"
          ]
        },
        "uniqueItems": true
      },
      "timezone": {
        "type": "string",
        "title": "Timezone",
        "description": "IANA timezone for interpreting all-day events and formatting display times.",
        "default": "America/Los_Angeles",
        "ui:widget": "timezone"
      },
      "refresh_seconds": {
        "type": "integer",
        "title": "Refresh Interval (seconds)",
        "description": "How often to refresh game data during a game. Starts 15 minutes prior to first pitch and continues until game concludes",
        "default": 180,
        "minimum": 60
      }
    },
    "required": ["teams"]
  },
  "variables": {
    "groups": {
      "game": { "label": "Game" },
      "teams": { "label": "Teams" },
      "stats": { "label": "Stats" }
    },
    "simple": {
      "game_scheduled_start": {
        "description": "Scheduled Start Time of Game in Timezone configured",
        "type": "string",
        "max_length": 20,
        "group": "game",
        "example": "2026-06-04T15:10:00Z"
      },
      "minutes_until_game": {
        "description": "Minutes until scheduled game start",
        "type": "integer",
        "max_length": 4,
        "group": "game",
        "example": "67"
      },
      "game_status_code": {
        "description": "F=Final, P=PreGame",
        "type": "string",
        "max_length": 1,
        "group": "game",
        "example": "F"
      },
      "home_team_name": {
        "description": "Home Team",
        "type": "string",
        "max_length": 20,
        "group": "teams",
        "example": "Seattle Mariners"
      },
      "home_team_abbr": {
        "description": "Home Team Abbreviation",
        "type": "string",
        "max_length": 3,
        "group": "teams",
        "example": "SEA"
      },
      "home_team_club_name": {
        "description": "Home Team Club Name",
        "type": "string",
        "max_length": 20,
        "group": "teams",
        "example": "Mariners"
      },
      "home_team_color": {
        "description": "Home Team Primary Color",
        "type": "string",
        "max_length": 6,
        "group": "teams",
        "example": "red"
      },
      "away_team_name": {
        "description": "Away Team",
        "type": "string",
        "max_length": 20,
        "group": "teams",
        "example": "Seattle Mariners"
      },
      "away_team_abbr": {
        "description": "Away Team Abbreviation",
        "type": "string",
        "max_length": 3,
        "group": "teams",
        "example": "SEA"
      },
      "away_team_club_name": {
        "description": "Away",
        "type": "string",
        "max_length": 20,
        "group": "teams",
        "example": "Mariners"
      },
      "away_team_color": {
        "description": "Away Team Primary Color",
        "type": "string",
        "max_length": 6,
        "group": "teams",
        "example": "yellow"
      },
      "stadium": {
        "description": "Stadium",
        "type": "string",
        "max_length": 15,
        "group": "game",
        "example": "Wrigley Field"
      },
      "current_inning": {
        "description": "Current Inning of Live Game",
        "type": "integer",
        "max_length": 2,
        "group": "stats",
        "example": "3"
      },
      "current_inning_state": {
        "description": "Top or Bottom",
        "type": "string",
        "max_length": 6,
        "group": "stats",
        "example": "BOTTOM"
      },
      "current_home_score": {
        "description": "Current score for the Home Team",
        "type": "integer",
        "max_length": 2,
        "group": "stats",
        "example": "3"
      },
      "current_home_hits": {
        "description": "Current hits for the Home Team",
        "type": "integer",
        "max_length": 2,
        "group": "stats",
        "example": "8"
      },
      "current_home_errors": {
        "description": "Current errors for the Home Team",
        "type": "integer",
        "max_length": 2,
        "group": "stats",
        "example": "1"
      },
      "current_away_score": {
        "description": "Current score for the Away Team",
        "type": "integer",
        "max_length": 2,
        "group": "stats",
        "example": "4"
      },
      "current_away_hits": {
        "description": "Current hits for the Away Team",
        "type": "integer",
        "max_length": 2,
        "group": "stats",
        "example": "8"
      },
      "current_away_errors": {
        "description": "Current errors for the Away Team",
        "type": "integer",
        "max_length": 2,
        "group": "stats",
        "example": "1"
      }
    }
  },
  "demo": {
    "flagship": {
      "name": "MLB - Upcoming Game - Demo - Flagship",
      "template": [
        "{{mlb.stadium}}",
        "",
        "{{mlb.away_team_club_name}} @\u00a0{{mlb.home_team_club_name}}\u00a0IN {{= FLOOR(mlb.minutes_until_game/60) }}H {{= MOD(mlb.minutes_until_game,60) }}M",
        "",
        "",
        ""
      ],
      "line_metadata": [
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": true
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        }
      ]
    },
    "note": {
      "name": "MLB - Upcoming Game - Demo - Note",
      "template": [
        "{{mlb.stadium}}",
        "{{mlb.away_team_club_name}} @\u00a0{{mlb.home_team_club_name}}\u00a0IN {{= FLOOR(mlb.minutes_until_game/60) }}H {{= MOD(mlb.minutes_until_game,60) }}M",
        ""
      ],
      "line_metadata": [
        {
          "alignment": "center",
          "wrap": false
        },
        {
          "alignment": "center",
          "wrap": true
        },
        {
          "alignment": "left",
          "wrap": false
        }
      ]
    },
    "note": {
      "name": "MLB - Scoreboard - Demo - Note",
      "template": [
        "{{= PAD(SWITCH(mlb.game_status_code,"P","UPCOMING","F","FINAL","I",CONCAT(" ",mlb.current_inning,SWITCH(mlb.current_inning,1,"ST",2,"ND",3,"RD","TH")),"UNKNOWN"),8) }}R  H  E ",
        "{{= IF(OR(mlb.game_status_code!="I",AND(mlb.game_status_code=="I",mlb.current_inning_state=="Top")),COLOR(mlb.away_team_color)," ") }}{{= PAD(mlb.away_team_abbr,6) }}{{= PADLEFT(mlb.current_away_score,2) }}{{= PADLEFT(mlb.current_away_hits,3) }}{{= PADLEFT(mlb.current_away_errors,3) }}",
        "{{= IF(OR(mlb.game_status_code!="I",AND(mlb.game_status_code="I",mlb.current_inning_state="Bottom")),COLOR(mlb.home_team_color)," ") }}{{= PAD(mlb.home_team_abbr,6) }}{{= PADLEFT(mlb.current_home_score,2) }}{{= PADLEFT(mlb.current_home_hits,3) }}{{= PADLEFT(mlb.current_home_errors,3) }}"
      ],
      "line_metadata": [
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        }
      ]
    },
    "note": {
      "name": "MLB - Current Score - Demo - Note",
      "template": [
        "{{mlb.current_inning_state}} {{mlb.current_inning}}{{= SWITCH(mlb.current_inning,1,"ST",2,"ND",3,"RD","TH") }}",
        "{{= COLOR(mlb.away_team_color) }}{{mlb.away_team_club_name}}{{= PADLEFT(mlb.current_away_score,ABS(SUM(-14,LEN(mlb.away_team_club_name)))) }}",
        "{{= COLOR(mlb.home_team_color) }}{{mlb.home_team_club_name}}{{= PADLEFT(mlb.current_home_score,ABS(SUM(-14,LEN(mlb.home_team_club_name)))) }}"
      ],
      "line_metadata": [
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        },
        {
          "alignment": "left",
          "wrap": false
        }
      ]
    }
  }
}
